map "$status:$uri" $cache_control {
  default "no-cache";
  ~^(200|304):/assets/ "public, max-age=31536000, immutable";
  ~:/healthz$ "no-store";
}

# Access logs omit query strings: Supabase callbacks contain authorization codes.
log_format spa '$remote_addr [$time_local] "$request_method $uri $server_protocol" $status $body_bytes_sent';

server {
  listen ${PORT};
  server_name _;
  server_tokens off;
  root /usr/share/nginx/html;
  index index.html;
  access_log /dev/stdout spa;
  error_log /dev/stderr warn;

  add_header Cache-Control $cache_control always;
  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy no-referrer always;

  gzip on;
  gzip_vary on;
  gzip_min_length 1024;
  gzip_types text/css application/javascript application/json application/wasm image/svg+xml;

  location = /healthz {
    default_type text/plain;
    return 200 "ok\n";
  }

  # Missing scripts must be a real 404, not HTML returned with a 200 status.
  location /assets/ {
    try_files $uri =404;
  }
  location /vendor/ {
    try_files $uri =404;
  }

  # Includes direct loads and refreshes of both Supabase auth routes.
  location / {
    try_files $uri $uri/ /index.html;
  }
}
