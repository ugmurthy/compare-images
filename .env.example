# Copy to .env.local and replace these empty values with the shared project's
# URL and PUBLIC publishable key (sb_publishable_...) or legacy anon key.
# Both VITE_ values are compiled into the browser bundle; they are not secrets.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# NEVER put a service-role/secret key, database password, JWT signing secret,
# or Google client secret in this file or any VITE_ environment variable.
