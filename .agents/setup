#!/usr/bin/env bash
set -euo pipefail

cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."

# Bun and Node are supplied by the Amp orb base image; no extra system
# packages, credentials, or backing services are needed by this browser app.
echo 'Checking the orb toolchain'
bun --version
node --version

echo 'Installing dependencies from bun.lock'
time bun install --frozen-lockfile
